# Modèle du fichier d'environnement de recette / production.
# Copier en .env.prod sur le serveur, remplir les valeurs, ne JAMAIS committer le fichier rempli.
ENVIRONNEMENT=prod                    # prod ou recette
DOMAINE=reservation.exemple.fr
APP_IMAGE=ghcr.io/arthurgmd63/titreb3:latest

# Secrets : générer chacun avec `openssl rand -hex 32` (JWT : `openssl rand -hex 48`)
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

# Serveur SMTP réel (en recette : SMTP_HOST=mailhog, SMTP_PORT=1025)
SMTP_HOST=
SMTP_PORT=587
MAIL_FROM=reservation@exemple.fr

AUDIT_RETENTION_DAYS=365
