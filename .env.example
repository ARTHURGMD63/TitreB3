# Copier ce fichier en .env pour le développement local (ne jamais committer .env)
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TZ_APP=Europe/Paris

# PostgreSQL : compte applicatif (droits limités) et compte admin (migrations uniquement)
DATABASE_URL=postgres://resa_app:resa_app_dev@localhost:5432/reservation
DATABASE_ADMIN_URL=postgres://postgres:postgres_dev@localhost:5432/reservation
APP_DB_PASSWORD=resa_app_dev

# MongoDB (journal d'audit)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=reservation_audit
AUDIT_RETENTION_DAYS=365

# Authentification : en production, générer avec `openssl rand -hex 48`
JWT_SECRET=dev-secret-a-remplacer-par-une-valeur-aleatoire-longue
JWT_EXPIRES_IN=2h
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Emails (Mailhog en développement : interface sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=reservation@exemple.local

# Mot de passe des comptes de démonstration créés par `npm run db:seed`
SEED_PASSWORD=Demo-Passw0rd!
